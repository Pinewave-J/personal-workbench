  "cards": [
    {
      "dot": "emerald",
      "title": "三条命令构成一生",
      "items": [
        "上传：POST /results 把 base64 落盘并写元数据",
        "预览：GET /results/:id/content 以 inline 返回原件",
        "补传：PUT /results/:id/content 把原件挂回原记录"
      ]
    },
    {
      "dot": "rose",
      "title": "文件缺失不是意外",
      "items": [
        "备份 JSON 只含元数据，恢复后不会带回文件二进制",
        "列表接口会算出 exists，界面据此显示「文件缺失」",
        "缺失行的操作变成「重新上传」，预览按钮被替换"
      ]
    },
    {
      "dot": "cyan",
      "title": "预览的安全边界",
      "items": [
        "外链结果 HTML 在 iframe 里以 sandbox 打开，禁其脚本",
        "下载端用 relative 判定路径，防止越出 uploads 目录",
        "响应带 nosniff，避免把内容当别的类型执行"
      ]
    }
  ]
